# Copy to .env and fill in. Server-side only: never commit the real file.

ENVIRONMENT=development
LOG_LEVEL=INFO
# Where the frontend runs (comma-separated; add your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000

# Supabase > Project Settings > API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only if your project still uses the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=devhub-files

# Supabase > Connect > Session pooler > URI
DATABASE_URL=

# Vault encryption key. Back it up: if it changes, stored credentials become unreadable.
VAULT_ENCRYPTION_KEY=
