# ---------------------------------------------------------------------------
# Dependencies & build output (any depth, so they stay ignored inside frontend/ and backend/)
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Python (backend)
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Throw-away Postgres used by the integration tests
.pgtest/

# ---------------------------------------------------------------------------
# Secrets & local config: never commit. Keep the *.example templates.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Tooling / OS
# ---------------------------------------------------------------------------
.vercel
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
